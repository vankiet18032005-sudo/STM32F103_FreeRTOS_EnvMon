  89:Core/Src/oled.c **** void OLED_Init(void)
  90:Core/Src/oled.c **** {
  91:Core/Src/oled.c ****     /* Wait 100ms for power stabilization */
  92:Core/Src/oled.c ****     osDelay(100);
  93:Core/Src/oled.c **** 
  94:Core/Src/oled.c ****     /* Send entire init sequence in a single I2C blocking transaction */
  95:Core/Src/oled.c ****     HAL_I2C_Master_Transmit(&hi2c1, OLED_ADDRESS, (uint8_t *)oled_init_sequence, sizeof(oled_init_s
  96:Core/Src/oled.c **** 
  97:Core/Src/oled.c ****     /* Clear framebuffer and push initial frame via DMA */
  98:Core/Src/oled.c ****     OLED_Clear();
  99:Core/Src/oled.c ****     OLED_Update_DMA_SingleFrame();
 100:Core/Src/oled.c **** }
