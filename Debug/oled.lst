  72:Core/Src/oled.c **** /**
  73:Core/Src/oled.c ****   * @brief  Send a single command byte via blocking I2C.
  74:Core/Src/oled.c ****   * @param  cmd: SSD1306 command byte
  75:Core/Src/oled.c ****   * @retval None
  76:Core/Src/oled.c ****   */
  77:Core/Src/oled.c **** static void OLED_WriteCmd(uint8_t cmd)
  78:Core/Src/oled.c **** {
  79:Core/Src/oled.c ****     uint8_t buf[2];
  80:Core/Src/oled.c ****     buf[0] = 0x00;  /* Control byte: command mode */
  81:Core/Src/oled.c ****     buf[1] = cmd;
  82:Core/Src/oled.c ****     HAL_I2C_Master_Transmit(&hi2c1, OLED_ADDRESS, buf, 2, 100);
  83:Core/Src/oled.c **** }
  84:Core/Src/oled.c **** 
  85:Core/Src/oled.c **** /**
