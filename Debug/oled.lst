  21:Core/Src/oled.c **** /* ---------- Private SSD1306 Initialization Commands ---------- */
  22:Core/Src/oled.c **** static const uint8_t oled_init_sequence[] = {
  23:Core/Src/oled.c ****     0x00,             /* Control byte: Co = 0, D/C# = 0 (stream of commands) */
  24:Core/Src/oled.c ****     0xAE,             /* Display OFF */
  25:Core/Src/oled.c ****     0xD5, 0x80,       /* Set Display Clock Divide Ratio / Oscillator Frequency */
  26:Core/Src/oled.c ****     0xA8, 0x3F,       /* Set Multiplex Ratio (64MUX for 128x64) */
  27:Core/Src/oled.c ****     0xD3, 0x00,       /* Set Display Offset to 0 */
  28:Core/Src/oled.c ****     0x40,             /* Set Display Start Line to 0 */
  29:Core/Src/oled.c ****     0x8D, 0x14,       /* Charge Pump Setting: Enable charge pump */
  30:Core/Src/oled.c ****     0x20, 0x00,       /* Set Memory Addressing Mode: Horizontal addressing mode */
  31:Core/Src/oled.c ****     0xA1,             /* Set Segment Re-map: Column 127 mapped to SEG0 */
ARM GAS  C:\Users\admin\AppData\Local\Temp\ccMjU8BM.s 			page 2


  32:Core/Src/oled.c ****     0xC8,             /* Set COM Output Scan Direction: Remapped mode */
  33:Core/Src/oled.c ****     0xDA, 0x12,       /* Set COM Pins Hardware Configuration: Alternative COM config */
  34:Core/Src/oled.c ****     0x81, 0xCF,       /* Set Contrast Control to 0xCF */
  35:Core/Src/oled.c ****     0xD9, 0xF1,       /* Set Pre-charge Period */
  36:Core/Src/oled.c ****     0xDB, 0x40,       /* Set VCOMH Deselect Level */
  37:Core/Src/oled.c ****     0xA4,             /* Entire Display ON: Resume to RAM content */
  38:Core/Src/oled.c ****     0xA6,             /* Set Normal Display (not inverse) */
  39:Core/Src/oled.c ****     0x21, 0x00, 0x7F, /* Set Column Address Range: start = 0, end = 127 */
  40:Core/Src/oled.c ****     0x22, 0x00, 0x07, /* Set Page Address Range: start = 0, end = 7 */
  41:Core/Src/oled.c ****     0xAF              /* Display ON */
  42:Core/Src/oled.c **** };
